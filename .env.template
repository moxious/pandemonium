# Copy to .env and fill in your keys: cp .env.template .env
# .env is gitignored. Never commit real keys.
# Every setting except the API key for your provider is optional;
# the values shown are the defaults in pandemonium/config.py.

# --- Providers ---------------------------------------------------------

# Provider for agents that do not name one: openai or anthropic.
DEFAULT_PROVIDER=openai

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-6.2-astra
# Reasoning effort for OpenAI reasoning models (low, medium, high).
# While this is set, TEMPERATURE is not sent to OpenAI, because reasoning
# models only accept the default. Leave it empty to use a model without
# reasoning, such as gpt-4o.
OPENAI_REASONING_EFFORT=medium

# Only needed if DEFAULT_PROVIDER=anthropic or a config file assigns
# agents to Anthropic.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-6

# Applies to Anthropic models, and to OpenAI models when
# OPENAI_REASONING_EFFORT is empty.
TEMPERATURE=0.7

# --- Context windowing -------------------------------------------------

# Round-based strategies: past rounds each agent sees, and the round
# after which a broker summary of earlier discussion is added.
CONTEXT_ROUNDS=3
SUMMARY_AFTER_ROUNDS=3

# Message-based strategies (chatroom): sliding window size, and how often
# (in messages) the summary is regenerated.
CONTEXT_MESSAGES=20
SUMMARY_AFTER_MESSAGES=15

# --- Logging -----------------------------------------------------------

# DEBUG, INFO, WARNING, or ERROR. Used when pandemonium runs as a library;
# main.py always applies its --log-level flag (default INFO) instead.
LOG_LEVEL=INFO
